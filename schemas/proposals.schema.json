{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proposals.schema.json",
  "title": "Reviewer output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposals"
  ],
  "properties": {
    "proposals": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "kind",
          "new_text",
          "rationale",
          "source_lessons"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "prompt_rule",
              "pattern",
              "test",
              "checklist"
            ]
          },
          "old_text": {
            "type": "string"
          },
          "new_text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 800
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 600
          },
          "source_lessons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  }
}
