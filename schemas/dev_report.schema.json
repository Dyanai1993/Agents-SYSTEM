{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev_report.schema.json",
  "title": "Developer report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "files_changed"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests_added": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests_run": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
