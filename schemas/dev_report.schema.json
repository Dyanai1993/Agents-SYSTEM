{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev_report.schema.json",
  "title": "Developer report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "files_changed"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests_added": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests_run": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "blocking_kind": {
      "enum": [
        "user_input",
        "environment"
      ]
    },
    "blocking_reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "tests_added",
          "tests_run"
        ],
        "properties": {
          "tests_run": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": [
          "blocking_kind",
          "blocking_reason"
        ]
      }
    }
  ]
}
