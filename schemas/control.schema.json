{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control.schema.json",
  "title": "Control file (pause/stop)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "action",
    "requested_at"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "action": {
      "enum": [
        "pause",
        "stop",
        "resume"
      ]
    },
    "requested_at": {
      "type": "string"
    }
  }
}
