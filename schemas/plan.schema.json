{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Architect plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "complexity",
    "tech_choices",
    "work_items",
    "test_strategy",
    "risks"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "complexity": {
      "enum": [
        "trivial",
        "normal",
        "complex"
      ]
    },
    "tech_choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "choice",
          "reason",
          "rejected"
        ],
        "properties": {
          "choice": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "rejected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "files",
          "acceptance_criteria"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "test_strategy": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
