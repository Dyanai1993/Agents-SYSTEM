{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Architect plan",
  "type": "object",
  "required": [
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "ok",
        "needs_input"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "complexity": {
      "enum": [
        "trivial",
        "normal",
        "complex"
      ]
    },
    "tech_choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "choice",
          "reason"
        ],
        "properties": {
          "choice": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rejected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "files",
          "acceptance_criteria",
          "covers",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,19}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "description": "Expected files. A hint, not an allowlist. Extra test files are allowed."
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "covers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^AC[0-9]+$"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "test_strategy": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocking_reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "summary",
          "complexity",
          "tech_choices",
          "work_items",
          "test_strategy",
          "risks"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_input"
          }
        }
      },
      "then": {
        "required": [
          "blocking_reason",
          "questions"
        ]
      }
    }
  ]
}
