{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson.schema.json",
  "title": "Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "task_id",
    "ts",
    "kind",
    "role",
    "key",
    "text"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "ts": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "kind": {
      "enum": [
        "fix_loop",
        "replan",
        "coverage_gap",
        "evidence_rejected",
        "schema_failure",
        "blocked",
        "limit_hit"
      ]
    },
    "role": {
      "enum": [
        "architect",
        "developer",
        "tester",
        "orchestrator",
        "all"
      ]
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\n`{}]*$"
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
